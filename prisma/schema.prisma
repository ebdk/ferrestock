generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum rol_usuario {
  ADMIN
  EMPLEADO
  REPARTIDOR
}

enum categoria_tipo_producto {
  FERRETERIA
  CORRALON
}

model usuarios {
  id                    Int         @id @default(autoincrement())
  nombre                String
  email                 String      @unique
  password_hash         String
  rol                   rol_usuario
  activo                Boolean     @default(true)
  requiere_cambio_clave Boolean     @default(false)
  created_at            DateTime    @default(now())

  @@map("usuarios")
}

model clientes {
  id         Int       @id @default(autoincrement())
  nombre     String
  direccion  String
  lat        Decimal?  @db.Decimal(10, 7)
  lng        Decimal?  @db.Decimal(10, 7)
  telefonos  String[]
  notas      String?
  activo     Boolean   @default(true)
  created_at DateTime  @default(now())
  compras    compras[]

  @@map("clientes")
}

model compras {
  id           Int       @id @default(autoincrement())
  cliente_id   Int
  fecha        DateTime  @default(now())
  total_con_iva Decimal  @db.Decimal(12, 2)
  cliente      clientes  @relation(fields: [cliente_id], references: [id])

  @@map("compras")
}

model productos {
  id                Int                    @id @default(autoincrement())
  nombre            String
  codigo            String                 @unique
  categoria_tipo    categoria_tipo_producto
  unidad_venta      String
  precio_sin_iva    Decimal                @db.Decimal(12, 2)
  precio_con_iva    Decimal                @db.Decimal(12, 2)
  stock_actual      Decimal                @db.Decimal(12, 3)
  stock_minimo      Decimal                @db.Decimal(12, 3)
  densidad_pulgadas String?
  longitud_metros   Decimal?               @db.Decimal(12, 3)
  precio_por_metro  Decimal?               @db.Decimal(12, 2)
  activo            Boolean                @default(true)

  @@map("productos")
}
