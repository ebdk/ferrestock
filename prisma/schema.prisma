generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum rol_usuario {
  ADMIN
  EMPLEADO
  REPARTIDOR
}

enum categoria_tipo_producto {
  FERRETERIA
  CORRALON
}

enum tipo_movimiento_stock {
  VENTA
  AJUSTE
  ENTRADA
}

enum medio_pago {
  EFECTIVO
  DEBITO
  CREDITO
  BILLETERA_VIRTUAL
  TRANSFERENCIA
  CHEQUE
  CUENTA_CORRIENTE
}

model usuarios {
  id                    Int         @id @default(autoincrement())
  nombre                String
  email                 String      @unique
  password_hash         String
  rol                   rol_usuario
  activo                Boolean     @default(true)
  requiere_cambio_clave Boolean     @default(false)
  created_at            DateTime    @default(now())

  @@map("usuarios")
}

model clientes {
  id         Int       @id @default(autoincrement())
  nombre     String
  direccion  String
  lat        Decimal?  @db.Decimal(10, 7)
  lng        Decimal?  @db.Decimal(10, 7)
  telefonos  String[]
  notas      String?
  activo     Boolean   @default(true)
  created_at DateTime  @default(now())
  compras    compras[]

  @@map("clientes")
}

model compras {
  id             Int           @id @default(autoincrement())
  cliente_id     Int
  fecha          DateTime      @default(now())
  hora_inicio    DateTime?
  atendido_por_id Int?
  total_sin_iva  Decimal?      @db.Decimal(12, 2)
  total_con_iva  Decimal       @db.Decimal(12, 2)
  saldo_pendiente Decimal?     @db.Decimal(12, 2)
  estado         String?
  requiere_envio Boolean       @default(false)
  cliente        clientes      @relation(fields: [cliente_id], references: [id])
  items          compra_items[]
  pagos          pagos[]

  @@map("compras")
}

model productos {
  id                Int                    @id @default(autoincrement())
  nombre            String
  codigo            String                 @unique
  categoria_tipo    categoria_tipo_producto
  unidad_venta      String
  precio_sin_iva    Decimal                @db.Decimal(12, 2)
  precio_con_iva    Decimal                @db.Decimal(12, 2)
  stock_actual      Decimal                @db.Decimal(12, 3)
  stock_minimo      Decimal                @db.Decimal(12, 3)
  densidad_pulgadas String?
  longitud_metros   Decimal?               @db.Decimal(12, 3)
  precio_por_metro  Decimal?               @db.Decimal(12, 2)
  activo            Boolean                @default(true)
  movimientos_stock stock_movimientos[]

  @@map("productos")
}

model stock_movimientos {
  id         Int                  @id @default(autoincrement())
  producto_id Int
  tipo       tipo_movimiento_stock
  cantidad   Decimal              @db.Decimal(12, 3)
  motivo     String
  created_by Int
  created_at DateTime             @default(now())
  producto   productos            @relation(fields: [producto_id], references: [id])

  @@map("stock_movimientos")
}

model compra_items {
  id             Int       @id @default(autoincrement())
  compra_id      Int
  producto_id    Int
  cantidad       Decimal   @db.Decimal(12, 3)
  longitud_metros Decimal? @db.Decimal(12, 3)
  es_corte       Boolean   @default(false)
  precio_unitario Decimal  @db.Decimal(12, 2)
  subtotal       Decimal   @db.Decimal(12, 2)
  compra         compras   @relation(fields: [compra_id], references: [id])

  @@map("compra_items")
}

model pagos {
  id       Int       @id @default(autoincrement())
  compra_id Int
  medio    medio_pago
  monto    Decimal   @db.Decimal(12, 2)
  compra   compras   @relation(fields: [compra_id], references: [id])

  @@map("pagos")
}
